# Lazarus / Free Pascal build products and editor state
/lib/
backup/
*.o
*.obj
*.ppu
*.a
*.so
*.dll
*.exe
*.compiled
*.or
*.res
*.lps
*.bak
*.swp
*~
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Application/test executables and interrupted build replacements
/zgui
/gwdgui
/.zgui-*-build
/.zgui-*-new
/.gwdgui-new-build
/tests/*_check

# Generated documentation and release packages
/output/
/dist/
/releases/

# Logs and temporary files
*.log
*.tmp
/*.trace

# Local SQLite databases, journals and write-ahead logs
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*

# Local engine installations, downloaded networks and tablebases
/GWD/
/engines/
/engine[0-9]*/
/endgine[0-9]*/
/engne[0-9]*/
/enginge[0-9]*/
*.zst

# Machine-specific settings (engine option files may be beside the engine)
/engines.json
/prefs.json
*.params.json

# Local game exports; keep fixtures and opening/benchmark source data trackable
/Test.pgn
/Test.pdn
/Tournament.pgn
/Tournament.pdn

# Local review notes; already tracked documents remain in the project history
/REFACTORING.md
/REVIEW_NOTES.md
/claude/
/chatgpt/

# Root-local neural networks and data files
/network*.json
/*.bin
/*.dat
/*.nn

# Tournament ownership sidecars (OS-held locks, not source files)
*.json.lock
*.pgn.lock
*.pdn.lock
